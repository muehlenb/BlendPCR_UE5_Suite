#include "/Engine/Private/Common.ush"

// uniforms entsprechend deinem C++-Struct
Texture2D<float4> PointCloudTex : register(t0);
Texture2D<float> EdgeProximityTex : register(t1);
SamplerState PointSampler : register(s0);

float p_h;
float kernelSpread;
int kernelRadius;
float2 TexSize;

struct VSOutput
{
    float4 Position : SV_POSITION;
    float2 UV : TEXCOORD0;
};

VSOutput MainVS(uint VertexID : SV_VertexID)
{
    VSOutput Out;

    float2 Pos[3] =
    {
        float2(-1.0, -1.0),
        float2(-1.0, 3.0),
        float2(3.0, -1.0)
    };

    Out.Position = float4(Pos[VertexID], 0.0, 1.0);
    Out.UV = float2(Out.Position.x * 0.5f + 0.5f, 1.0f - (Out.Position.y * 0.5f + 0.5f));
    return Out;
}

float calculateTheta(float3 p, float3 x, float p_h)
{
    float d = distance(p, x);
    return exp(-((d * d) / (p_h * p_h)));
}

float4 MainPS(VSOutput In) : SV_Target0
{
    float2 texelSize = 1.0 / TexSize;

    float3 mid = PointCloudTex.Sample(PointSampler, In.UV).xyz;
    if (mid.z < 0.1)
        discard;

    float edgeDistance = EdgeProximityTex.Sample(PointSampler, In.UV).r;
    if (edgeDistance > 0.99)
        return float4(0, 0, -1.0, 1.0);

    int usedRadius = clamp(int(edgeDistance * 10), 2, kernelRadius);

    float3 sumPoints = 0;
    float sumWeights = 0;

    [loop]
    for (int dX = -usedRadius; dX <= usedRadius; ++dX)
    {
        [loop]
        for (int dY = -usedRadius; dY <= usedRadius; ++dY)
        {
            float2 coord = In.UV + float2(dX, dY) * texelSize;
            float3 p = PointCloudTex.SampleLevel(PointSampler, coord, 0).xyz;
            float edgeDist = EdgeProximityTex.SampleLevel(PointSampler, coord, 0).r;

            if (edgeDist > 0.99)
                continue;

            float theta = (dX != 0 || dY != 0) ? calculateTheta(mid, p, p_h) : 1.0;
            float weight = theta * clamp(edgeDist, 0.5, 1.0);

            sumPoints += p * weight;
            sumWeights += clamp(weight, 1e-6, 1e5);
        }
    }

    if (sumWeights > 1e-7){
        return float4(sumPoints / sumWeights, 1.0);
    } else {
        return float4(0.0, 0.0, 10.0, 1.0);
    }
}