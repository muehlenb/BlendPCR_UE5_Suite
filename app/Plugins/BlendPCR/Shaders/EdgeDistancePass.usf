#include "/Engine/Private/Common.ush"

Texture2D<float> RejectedTex : register(t0);
SamplerState PointSampler : register(s0);
float2 TexSize;

// --- Fullscreen-Triangle-VertexShader ---
struct VSOutput
{
    float4 Position : SV_POSITION;
    float2 UV : TEXCOORD0;
};

VSOutput MainVS(uint VertexID : SV_VertexID)
{
    VSOutput Out;

    // drei Ecken des Fullscreen-Triangles
    float2 Pos[3] =
    {
        float2(-1.0, -1.0),
        float2(-1.0, 3.0),
        float2(3.0, -1.0)
    };

    Out.Position = float4(Pos[VertexID], 0.0, 1.0);
    Out.UV = float2(Out.Position.x * 0.5f + 0.5f, 1.0f - (Out.Position.y * 0.5f + 0.5f));
    return Out;
}


// --- PixelShader ---
float4 MainPS(VSOutput In) : SV_Target0
{
    float2 texelSize = 1.0 / TexSize;

    float edgeVal = RejectedTex.Sample(PointSampler, In.UV).r;
    if (edgeVal > 0.5)
        return float4(1, 1, 1, 1);

    int steps = 1;
    int rad = 4;
    
    int fullRad = steps * rad;
    float maxInfluence = 0.0;
    
    [loop]
    for (float dY = -rad * steps; dY <= rad * steps; dY += steps)
    {
        [loop]
        for (float dX = -rad * steps; dX <= rad * steps; dX += steps)
        {            
            float dist = sqrt(dX * dX + dY * dY);
            
            if (dist > fullRad)
                continue;

            float2 offset = float2(dX, dY) * texelSize;
            float2 coord = In.UV + offset;
            
            int2 pixel = int2(coord * TexSize); // falls coord bisher 0–1 UV war
            float value = RejectedTex.Load(int3(pixel, 0)).r;
            
            //float value = rand(coord); //            RejectedTex.Sample(PointSampler, coord).r;

            if (value > 0.5)
            {
                float d = clamp(1 - (dist / fullRad), 0.0, 1.0);
                if (!isnan(d))
                    maxInfluence = max(maxInfluence, d);
            }
        }
    }

    return float4(maxInfluence.xxx, 1.0);
}