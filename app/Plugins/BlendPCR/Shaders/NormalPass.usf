#include "/Engine/Private/Common.ush"

Texture2D<float4> InputVerticesTex : register(t0);
Texture2D<float4> MLSVerticesTex : register(t1);
Texture2D<float> EdgeProximityTex : register(t2);
SamplerState PointSampler : register(s0);

float p_h;
float kernelSpread;
int kernelRadius;
float2 TexSize;

#define EIG_DIM 3
#define EIG_DIM_SQR 9
static const float SQRT3 = 1.7320508;
#define PI 3.14159265

struct VSOutput
{
    float4 Position : SV_POSITION;
    float2 UV : TEXCOORD0;
};

// ------------------------------------------------------------
// Fullscreen-Triangle VS
// ------------------------------------------------------------
VSOutput MainVS(uint VertexID : SV_VertexID)
{
    VSOutput Out;
    float2 Pos[3] =
    {
        float2(-1.0, -1.0),
        float2(-1.0, 3.0),
        float2(3.0, -1.0)
    };

    Out.Position = float4(Pos[VertexID], 0.0, 1.0);
    Out.UV = float2(Out.Position.x * 0.5f + 0.5f,
                    1.0f - (Out.Position.y * 0.5f + 0.5f));
    return Out;
}

// ------------------------------------------------------------
// Matrix-Hilfsfunktionen: float[9] statt float3x3
// ------------------------------------------------------------
float getMatrixElem(float a[9], int n)
{
    return a[n];
}

void setMatrixElem(inout float a[9], int n, float val)
{
    a[n] = val;
}

void swapInt(inout int a, inout int b)
{
    int tmp = a;
    a = b;
    b = tmp;
}

// Austausch bestimmter Matrixelemente
void swapElem(inout float a[9], int i, int h)
{
    float tmp = a[i];
    a[i] = a[h];
    a[h] = tmp;
}

// ------------------------------------------------------------
// dswap / daxpy –  mit [loop] statt [unroll]
// ------------------------------------------------------------
void dswap_ported(inout float a[9], int x_idx, int y_idx, int n)
{
    [loop]
    for (int i = 0; i < n; i++)
    {
        float x_val = getMatrixElem(a, x_idx + i);
        float y_val = getMatrixElem(a, y_idx + i);
        setMatrixElem(a, x_idx + i, y_val);
        setMatrixElem(a, y_idx + i, x_val);
    }
}

void daxpy_ported(int n, float alpha, float x[9], int x_idx,
                  inout float y[9], int y_idx)
{
    [loop]
    for (int i = 0; i < n; i++)
    {
        float val = getMatrixElem(y, y_idx + i);
        val += alpha * x[x_idx + i];
        setMatrixElem(y, y_idx + i, val);
    }
}

// ------------------------------------------------------------
// Cholesky-Faktorisierung mit Pivoting
// ------------------------------------------------------------
void cholesky_ported(inout float a[9], out int jpvt[3], out int rank)
{
    float work[9];
    rank = 3;

    for (int k = 0; k < 3; k++)
        jpvt[k] = k;

    int ak_idx = 0;
    for (int k = 0; k < 3; k++)
    {
        int akk_idx = ak_idx + k;
        float maxdia = getMatrixElem(a, akk_idx);
        int maxl = k;

        int all_idx = akk_idx + 4; // EIG_DIM + 1
        [loop]
        for (int l = k + 1; l <= 2; l++)
        {
            float all_val = getMatrixElem(a, all_idx);
            if (all_val > maxdia)
            {
                maxdia = all_val;
                maxl = l;
            }
            all_idx += 4;
        }

        if (maxdia <= 1.0)
        {
            rank = k;
            break;
        }

        if (k != maxl)
        {
            dswap_ported(a, ak_idx, maxl * 3 + maxl, k);
            setMatrixElem(a, maxl * 3 + maxl, getMatrixElem(a, akk_idx));
            setMatrixElem(a, akk_idx, maxdia);
            swapInt(jpvt[maxl], jpvt[k]);
        }

        work[k] = sqrt(getMatrixElem(a, akk_idx));
        setMatrixElem(a, akk_idx, work[k]);
        int aj_idx = ak_idx + 3;

        for (int j = k + 1; j < 3; j++)
        {
            if (k != maxl)
            {
                if (j < maxl)
                    swapElem(a, aj_idx + k, maxl * 3 + j);
                else if (j != maxl)
                    swapElem(a, aj_idx + k, aj_idx + maxl);
            }

            float val = getMatrixElem(a, aj_idx + k) / work[k];
            setMatrixElem(a, aj_idx + k, val);
            work[j] = val;
            daxpy_ported(j - k, -work[j], work, k + 1, a, aj_idx + k + 1);
            aj_idx += 3;
        }

        ak_idx += 3;
    }
}

// ------------------------------------------------------------
// Eigenwerte-Berechnung
// ------------------------------------------------------------
float3 calc_eigenvalues_opt(float3x3 m)
{
    float h1 = m[1][1] * m[2][2];
    float h2 = m[1][2] * m[1][2];
    float h3 = m[0][1] * m[0][1];
    float h4 = m[0][2] * m[0][2];

    float a = -(m[0][0] + m[1][1] + m[2][2]);
    float b = m[0][0] * (m[1][1] + m[2][2]) + h1 - (h2 + h3 + h4);
    float c = m[0][0] * (h2 - h1) + h3 * m[2][2]
            - 2 * m[0][1] * m[0][2] * m[1][2]
            + h4 * m[1][1];

    float q = sqrt(max((a * a - 3.0 * b) / 9.0, 0.0));
    float r = (2.0 * a * a * a - 9.0 * a * b + 27.0 * c) / 54.0;
    r = clamp(r / (q * q * q + 1e-8), -1.0, 1.0);
    float theta = acos(r) / 3.0;

    float sinth = sin(theta);
    float costh = cos(theta);
    a /= 3.0;

    float3 lambda;
    lambda.x = -2.0 * q * costh - a;
    lambda.y = q * (costh + sinth * SQRT3) - a;
    lambda.z = q * (costh - sinth * SQRT3) - a;
    return lambda;
}

// ------------------------------------------------------------
// Eigenvektor-Berechnung (vereinfacht, identische Logik)
// ------------------------------------------------------------
int calc_eigenvector(float3x3 m, float lambda, out float3 v)
{
    [unroll]
    for (int i = 0; i < 3; i++)
        m[i][i] -= lambda;

    int jpvt[3];
    int rank;
    float aFlat[9];
    // flatten
    [unroll]
    for (int i = 0; i < 3; i++)
        [unroll]
        for (int j = 0; j < 3; j++)
            aFlat[i * 3 + j] = m[i][j];

    cholesky_ported(aFlat, jpvt, rank);

    float vv[3];
    vv[2] = 1.0;

    for (int k = 1; k >= 0; k--)
    {
        vv[k] = 0.0;
        for (int j = k + 1; j < 3; j++)
            vv[k] -= m[j][k] * vv[j];
        vv[k] /= m[k][k];
    }

    float l = sqrt(vv[0] * vv[0] + vv[1] * vv[1] + vv[2] * vv[2]);
    for (int i = 0; i < 3; i++)
        vv[i] /= l;
    
    if (jpvt[0] == 0)
        v.x = vv[0];
    else if (jpvt[0] == 1)
        v.y = vv[0];
    else
        v.z = vv[0];

    if (jpvt[1] == 0)
        v.x = vv[1];
    else if (jpvt[1] == 1)
        v.y = vv[1];
    else
        v.z = vv[1];

    if (jpvt[2] == 0)
        v.x = vv[2];
    else if (jpvt[2] == 1)
        v.y = vv[2];
    else
        v.z = vv[2];

    return rank;
}

// ------------------------------------------------------------
// Gewichtungsfunktion
// ------------------------------------------------------------
float calculateTheta(float3 p, float3 x)
{
    float d = distance(p, x);
    return exp(-(d * d) / (p_h * p_h));
}

// ------------------------------------------------------------
// Haupt-Pixelshader
// ------------------------------------------------------------
float4 MainPS(VSOutput In) : SV_Target0
{
    float2 texelSize = kernelSpread / TexSize;

    float3 a = MLSVerticesTex.SampleLevel(PointSampler, In.UV, 0).xyz;
    if (a.z < 0.1)
        discard;

    float3x3 B = (float3x3) 0;
    int radius = kernelRadius;

    [loop]
    for (int dX = -radius; dX <= radius; ++dX)
    {
        [loop]
        for (int dY = -radius; dY <= radius; ++dY)
        {
            float2 coord = In.UV + float2(dX, dY) * texelSize;
            if (coord.x < 0 || coord.y < 0 || coord.x > 1 || coord.y > 1)
                continue;

            float3 p = InputVerticesTex.SampleLevel(PointSampler, coord, 0).xyz;
            if (any(isnan(p)))
                continue;

            float theta = calculateTheta(a, p);

            [unroll(3)]
            for (int i = 0; i < 3; ++i)
            {
                [unroll(3)]
                for (int j = 0; j < 3; ++j)
                    B[j][i] += theta * (p[i] - a[i]) * (p[j] - a[j]);
            }
        }
    }

    float3 eigenvalues = calc_eigenvalues_opt(B);
    float lambda = min(min(eigenvalues.x, eigenvalues.y), eigenvalues.z);

    float3 eigenvector = float3(0, 0, 0);
    calc_eigenvector(B, lambda, eigenvector);

    float3 normal = -normalize(eigenvector);
    if (normal.z < 0)
        normal = -normal;

    if (any(isnan(normal)) || any(!isfinite(normal)) || length(normal) < 1e-4)
        normal = float3(0, 0, 1);

    return float4(normal, 1.0);
}
